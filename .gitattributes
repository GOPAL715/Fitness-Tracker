# Keep shell scripts and Docker entrypoints LF. A CRLF shebang is unparseable by /bin/sh inside a
# Linux container, so this is a build-correctness rule rather than a cosmetic preference.
*.sh text eol=lf
Dockerfile text eol=lf
.dockerfile text eol=lf

# Keep source files consistent across platforms.
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
