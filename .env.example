# FitTrack frontend environment
# This URL is included in the browser bundle and must include /api/v1.
#
# Only public configuration may use the VITE_ prefix: Vite inlines every VITE_ value into the
# client bundle, so a secret here would be shipped to every browser. Never add one.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Backend environment (server-side only, never VITE_ prefixed)
# ---------------------------------------------------------------------------
# Values below are DEVELOPMENT placeholders for docker-compose. They are not
# production credentials. Provide real values through your secret manager.
#
# APP_PRODUCTION=true enables the production guardrails: startup fails when a
# development or default secret is still configured.
# APP_PRODUCTION=false
# JWT_SECRET=at-least-32-characters-from-your-secret-manager
# DATABASE_URL=jdbc:postgresql://postgres:5432/fittrack
# DATABASE_USERNAME=fittrack
# DATABASE_PASSWORD=
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# STORAGE_PATH=/data/private
# REDIS_HOST=redis
# REDIS_PORT=6379
# RATE_LIMIT_REDIS_ENABLED=true
# RATE_LIMIT_AUTH_REQUESTS=10
# RATE_LIMIT_API_REQUESTS=300
# RATE_LIMIT_AI_REQUESTS=20
# OPENAI_API_KEY=
#
# Phase 22 AI safety limits. All optional; the defaults shown are what the app uses.
#   AI_TOKENS_PER_DAY       daily token ceiling per user. 0 disables it - not recommended.
#   AI_REQUESTS_PER_DAY     daily request ceiling per user, per AI feature.
#   AI_SUPPORTED_MODELS     comma-separated models this deployment may select. Startup fails if
#                           AI_VISION_MODEL or AI_TEXT_MODEL is not in this list.
#   AI_INPUT_PRICE_PER_MILLION / AI_OUTPUT_PRICE_PER_MILLION
#                           YOUR provider's current published rates. estimated_cost is an
#                           application-side ESTIMATE from these numbers, never provider billing.
#                           Default 0 means cost is not recorded; tokens still are.
# AI_TOKENS_PER_DAY=250000
# AI_REQUESTS_PER_MINUTE=10
# AI_REQUESTS_PER_DAY=100
# AI_SUPPORTED_MODELS=gpt-4o-mini
# AI_INPUT_PRICE_PER_MILLION=
# AI_OUTPUT_PRICE_PER_MILLION=

# Web Push (Phase 13/14). All four are optional: with FITTRACK_PUSH_ENABLED unset or false,
# reminders still schedule and delivery falls back to the existing permanent-failure
# path, so a deployment that sets nothing is unaffected.
#
# Generate a VAPID key pair once and store it in your secret manager. Never commit
# real values, and never prefix any of these with VITE_ - Vite inlines VITE_ variables into
# the browser bundle, which would publish the private key to every client.
#   openssl ecparam -genkey -name prime256v1 -noout | openssl ec -pubout
# FITTRACK_PUSH_ENABLED=true
# FITTRACK_VAPID_SUBJECT=mailto:ops@your-domain.example
# FITTRACK_VAPID_PUBLIC_KEY=
# FITTRACK_VAPID_PRIVATE_KEY=

# Push subscription writes are rate limited per authenticated user, separate from the
# general API budget.
# RATE_LIMIT_PUSH_REQUESTS=20
# RATE_LIMIT_PUSH_WINDOW_SECONDS=60
