# FitTrack frontend environment
# This URL is included in the browser bundle and must include /api/v1.
#
# Only public configuration may use the VITE_ prefix: Vite inlines every VITE_ value into the
# client bundle, so a secret here would be shipped to every browser. Never add one.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Backend environment (server-side only, never VITE_ prefixed)
# ---------------------------------------------------------------------------
# Values below are DEVELOPMENT placeholders for docker-compose. They are not
# production credentials. Provide real values through your secret manager.
#
# APP_PRODUCTION=true enables the production guardrails: startup fails when a
# development or default secret is still configured.
# APP_PRODUCTION=false
# JWT_SECRET=at-least-32-characters-from-your-secret-manager
# DATABASE_URL=jdbc:postgresql://postgres:5432/fittrack
# DATABASE_USERNAME=fittrack
# DATABASE_PASSWORD=
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# STORAGE_PATH=/data/private
# REDIS_HOST=redis
# REDIS_PORT=6379
# RATE_LIMIT_REDIS_ENABLED=true
# RATE_LIMIT_AUTH_REQUESTS=10
# RATE_LIMIT_API_REQUESTS=300
# RATE_LIMIT_AI_REQUESTS=20
# OPENAI_API_KEY=

